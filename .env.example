# SQLite 数据库路径（支持绝对路径，用于云端部署挂载持久化存储）
SQLITE_DB_PATH=./data/analytics.db

# 腾讯云 COS (对象存储)
COS_SECRET_ID=<your-secret-id>
COS_SECRET_KEY=<your-secret-key>
COS_BUCKET=<your-bucket-name>
COS_REGION=ap-guangzhou

# Analytics visit summary email (SMTP)
ANALYTICS_SUMMARY_EMAIL_ENABLED=false
ANALYTICS_SUMMARY_EMAIL_TO=<your-recipient-email>
ANALYTICS_PUBLIC_BASE_URL=https://ooooyasumi.com
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password-or-app-password>
SMTP_FROM=<sender-name-or-email>
