# Local-development default only. Production rejects relative paths and paths inside
# the replaceable release directory; use an absolute persistent path instead.
SQLITE_DB_PATH=./data/analytics.db

# Analytics administration.
# Required in production; use a unique value of at least 16 characters.
ANALYTICS_ADMIN_PASSWORD=
# Required in production; use an independent value of at least 32 random characters.
ANALYTICS_SESSION_SECRET=
# Optional bearer token for trusted server-to-server administration. When set in
# production, use at least 32 random characters.
ANALYTICS_ADMIN_TOKEN=

# Stable signature for public tracking payloads; use at least 32 random characters
# for multi-instance deployments or when visits must survive process restarts.
ANALYTICS_TRACKING_SECRET=
# Enable only behind a trusted reverse proxy that overwrites client IP headers.
ANALYTICS_TRUST_PROXY=false
# External IP geolocation is opt-in and is disabled by default.
ANALYTICS_IP_GEOLOCATION_ENABLED=false
# Raw visits older than this are removed opportunistically when a new visit arrives.
# Each share link also keeps at most the newest 10,000 visits.
ANALYTICS_RETENTION_DAYS=90

# Visit summary email. Keep disabled until SMTP and the public base URL are set.
ANALYTICS_SUMMARY_EMAIL_ENABLED=false
ANALYTICS_SUMMARY_EMAIL_TO=
ANALYTICS_PUBLIC_BASE_URL=http://127.0.0.1:3001
# Minimum completed visit duration before a summary email may be sent.
ANALYTICS_EMAIL_MIN_DURATION_MS=10000

# SMTP credentials are server-only secrets. Never prefix them with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
